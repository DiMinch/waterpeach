# ==============================================================================
# waterpeach Monorepo - LOCAL environment (docker compose)
# cp .env.example .env  ->  docker compose up --build
# Postgres + Redis chạy trong container, không cần Supabase.
# Môi trường CLOUD (Supabase + Cloud Run + Vercel): xem docs/CLOUD_SETUP.md
# ==============================================================================

APP_ENV=local

# Local PostgreSQL (container "postgres")
POSTGRES_USER=waterpeach
POSTGRES_PASSWORD=waterpeach_dev_password
POSTGRES_DB=waterpeach
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://waterpeach:waterpeach_dev_password@postgres:5432/waterpeach
DIRECT_URL=

# Supabase (để trống khi chạy local)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (Blacklist Cache & Realtime Pub/Sub)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Unified Backend & AI Service (FastAPI)
API_PORT=8000
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen
B2B_API_KEY=wp_dev_b2b_api_key

# Frontend (Next.js) - NEXT_PUBLIC_* được nhúng lúc build
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

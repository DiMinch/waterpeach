# ==============================================================================
# waterpeach-api - Environment Variables Template (Supabase + Redis + Gemini)
# ==============================================================================

APP_NAME=waterpeach-api
APP_ENV=development
DEBUG=true

# Supabase Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase PostgreSQL (AsyncPG)
# Use Supabase Connection Pooler (6543) at runtime and Direct URL (5432) for Alembic
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# Google Gemini AI
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen

# B2B Risk API Security
B2B_API_KEY=wp_dev_b2b_api_key

# CORS
CORS_ORIGINS=["http://localhost:3000"]

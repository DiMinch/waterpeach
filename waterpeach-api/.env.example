# ==============================================================================
# waterpeach-api - LOCAL environment (uv run, không qua docker cho API)
# cp .env.example .env
# Cần Postgres + Redis local: docker compose up -d postgres redis (từ thư mục gốc)
# Môi trường CLOUD: tạo .env.cloud theo docs/CLOUD_SETUP.md (không commit),
# chạy với ENV_FILE=.env.cloud
# ==============================================================================

APP_NAME=waterpeach-api
APP_ENV=local
DEBUG=true

# Supabase (để trống khi chạy local)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL (AsyncPG) - container postgres của docker-compose
DATABASE_URL=postgresql+asyncpg://waterpeach:waterpeach_dev_password@localhost:5432/waterpeach
# DIRECT_URL dùng cho Alembic; để trống thì dùng DATABASE_URL
DIRECT_URL=

# Redis (để trống để tắt Redis)
REDIS_URL=redis://localhost:6379/0

# Google Gemini AI
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-4-hydrogen

# B2B Risk API Security (header X-API-Key)
B2B_API_KEY=wp_dev_b2b_api_key

# CORS
CORS_ORIGINS=["http://localhost:3000"]
